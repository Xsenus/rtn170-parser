# Prefer local Unix socket peer authentication; no password needed in this case.
RTN_DATABASE_URL="dbname=rtn170 user=rtn170 host=/var/run/postgresql"

# Optional ProxyHarbor fallback. Keep the real token only in the process
# environment or a protected server secret; never commit it to this file.
PROXYHARBOR_API_TOKEN=""
PROXYHARBOR_MAX_LATENCY_MS="20000"
PROXYHARBOR_PROBE_LIMIT="400"

# Optional second provider; the real key belongs in a protected environment.
BEST_PROXIES_API_KEY=""
BEST_PROXIES_PROBE_LIMIT="400"
